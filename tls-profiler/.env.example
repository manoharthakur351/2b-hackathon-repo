# Strands Decider System One HTTP service.
DECIDER_API_URL=http://127.0.0.1:8099/v1/systemone
DECIDER_TIMEOUT_SECONDS=20

# Amazon Bedrock Converse. Set a currently available model ID for your region.
# Credentials come from the normal AWS credential chain (prefer an EC2 IAM role).
BEDROCK_MODEL_ID=
AWS_DEFAULT_REGION=

# A decision below this value safely routes to allow_and_monitor.
DECIDER_CONFIDENCE_THRESHOLD=0.55
